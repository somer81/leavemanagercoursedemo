# Environment variables the app reads. The app does NOT load a .env file: set them in the
# shell that starts it, e.g.  LEAVE_DB_PATH=data/leave.db .venv/bin/python -m uvicorn ...
# No secrets are needed by the walking skeleton.
# SQLite database file used by the running app (tests never use it). Default: data/leave.db
LEAVE_DB_PATH=data/leave.db
