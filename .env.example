# Environment variables the app reads. The app does NOT load a .env file: set them in the
# shell that starts it, e.g.  LEAVE_DB_PATH=data/leave.db .venv/bin/python -m uvicorn ...
# SQLite database file used by the running app and the seed (tests never use it). Default: data/leave.db
LEAVE_DB_PATH=data/leave.db
# Demo users' password for `python -m app.seed` (5–128 characters). Never commit a real value.
DEMO_PASSWORD=
# 1 = session cookie gets the Secure flag (required behind HTTPS in production). Default: off.
LEAVE_COOKIE_SECURE=
